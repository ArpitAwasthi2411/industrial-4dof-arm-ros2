<?xml version="1.0"?>
<!--
  materials.xacro
  Colour definitions for the 4-DOF industrial arm.
  RGBA components are in the range [0, 1].
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="dark_grey">
    <color rgba="0.20 0.20 0.22 1.0"/>
  </material>

  <material name="industrial_orange">
    <color rgba="1.00 0.45 0.05 1.0"/>
  </material>

  <material name="steel_grey">
    <color rgba="0.62 0.64 0.67 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <material name="tool_blue">
    <color rgba="0.10 0.35 0.80 1.0"/>
  </material>

</robot>
